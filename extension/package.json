{
  "name": "twitchphile",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs chromium && node build.mjs firefox",
    "build:chromium": "node build.mjs chromium",
    "build:firefox": "node build.mjs firefox",
    "package": "node build.mjs chromium && node build.mjs firefox && pwsh -NoProfile -File tools/build-zips.ps1",
    "watch": "node build.mjs chromium --watch",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "icons": "node scripts/icons.mjs",
    "fonts": "node scripts/fonts.mjs",
    "prepare": "npm run icons && npm run fonts"
  },
  "devDependencies": {
    "@fontsource-variable/exo-2": "^5.3.0",
    "@fontsource/kode-mono": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "@types/chrome": "^0.3.0",
    "esbuild": "^0.25.0",
    "subset-font": "^2.9.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "preact": "^10.29.8"
  }
}
