<Project Sdk="Microsoft.NET.Sdk">

  <!-- A plain console runner, like the rest of the family: no packages, runs offline, one command. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Twitchphile.Tests</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Twitchphile.Core\Twitchphile.Core.csproj" />
  </ItemGroup>

</Project>
